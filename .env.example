NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://user:password@localhost:5432/fearless_footballer
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_REFRESH_SECRET=replace-with-at-least-32-random-characters
PII_ENCRYPTION_KEY=replace-with-a-long-random-passphrase
CORS_ORIGIN=http://localhost:8000,http://localhost:3000
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=30d
CONSENT_POLICY_VERSION=beta-v1
RATE_LIMIT_AUTH_WINDOW_MS=900000
RATE_LIMIT_AUTH_LIMIT=5
RATE_LIMIT_GLOBAL_WINDOW_MS=900000
RATE_LIMIT_GLOBAL_LIMIT=100
EXPO_PUBLIC_API_BASE_URL=http://localhost:3000
EXPO_PUBLIC_API_MODE=local
EXPO_PUBLIC_PRIVACY_POLICY_URL=https://example.com/privacy
EXPO_PUBLIC_TERMS_URL=https://example.com/terms
