{
  "cli": {
    "version": ">= 14.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "simulator": true
      },
      "env": {
        "EXPO_PUBLIC_API_MODE": "local"
      }
    },
    "preview": {
      "distribution": "internal",
      "ios": {
        "simulator": false
      },
      "env": {
        "EXPO_PUBLIC_API_MODE": "production",
        "VITE_API_URL": "https://api.fearlessfootballer.com"
      }
    },
    "production": {
      "distribution": "store",
      "ios": {
        "simulator": false
      },
      "env": {
        "EXPO_PUBLIC_API_MODE": "production",
        "VITE_API_URL": "https://api.fearlessfootballer.com"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "appleId": "developer@fearlessfootballer.com",
        "ascAppId": "6440000000"
      },
      "android": {
        "serviceAccountKeyPath": "./google-service-account.json",
        "track": "internal"
      }
    }
  }
}
