{
  "expo": {
    "name": "Fearless Footballer",
    "slug": "fearless-footballer",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "fearlessfootballer",
    "userInterfaceStyle": "light",
    "platforms": ["ios", "android"],
    "plugins": [
      "expo-router",
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": true,
          "faceIDPermission": "Allow Fearless Footballer to use Face ID to protect your account."
        }
      ]
    ],
    "ios": {
      "bundleIdentifier": "com.fearlessfootballer.app",
      "supportsTablet": false
    },
    "android": {
      "package": "com.fearlessfootballer.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    }
  }
}
