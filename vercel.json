{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "pnpm run build",
  "outputDirectory": "dist/public",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/(auth|sessions|caregiver|athlete|health|admin|feedback)(.*)",
      "destination": "https://${process.env.RAILWAY_BACKEND_URL}/$1$2"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
